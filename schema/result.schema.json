{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CHIZI-0618/sing-box-inbound-bench/schema/result.schema.json",
  "title": "sing-box inbound benchmark raw repetition",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "run_id", "subject", "index", "warmup", "started_at", "duration_ns", "counters", "resources", "path_proof", "validity", "execution"],
  "properties": {
    "protocol_version": { "const": "inbound-bench/v2" },
    "run_id": { "type": "string" },
    "subject": { "enum": ["raw", "direct", "redirect", "tproxy", "tun", "tun-auto-redirect", "ebpf-tc", "ebpf-cgroup"] },
    "index": { "type": "integer", "minimum": 0 },
    "warmup": { "type": "boolean" },
    "started_at": { "type": "string", "format": "date-time" },
    "duration_ns": { "type": "integer", "minimum": 0 },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "failed", "bytes_sent", "bytes_received"],
      "properties": {
        "operations": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "bytes_sent": { "type": "integer", "minimum": 0 },
        "bytes_received": { "type": "integer", "minimum": 0 },
        "packets_sent": { "type": "integer", "minimum": 0 },
        "packets_received": { "type": "integer", "minimum": 0 },
        "lost": { "type": "integer", "minimum": 0 },
        "reordered": { "type": "integer", "minimum": 0 },
        "corrupt": { "type": "integer", "minimum": 0 }
      }
    },
    "latency_ns": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "uid", "cgroup_verified"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "uid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "cgroup_path": { "type": "string" },
        "cgroup_verified": { "type": "boolean" }
      }
    },
    "workload_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "setup_duration_ns", "active_duration_ns", "drain_duration_ns", "finished_at"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "setup_duration_ns": { "type": "integer", "minimum": 0 },
        "active_duration_ns": { "type": "integer", "minimum": 0 },
        "drain_duration_ns": { "type": "integer", "minimum": 0 },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_nanoseconds"],
      "properties": {
        "wall_nanoseconds": { "type": "integer", "minimum": 0 },
        "client_user_ticks": { "type": "integer", "minimum": 0 },
        "client_system_ticks": { "type": "integer", "minimum": 0 },
        "client_run_nanoseconds": { "type": "integer", "minimum": 0 },
        "client_read_bytes": { "type": "integer", "minimum": 0 },
        "client_write_bytes": { "type": "integer", "minimum": 0 },
        "client_rss_bytes": { "type": "integer", "minimum": 0 },
        "client_pss_bytes": { "type": "integer", "minimum": 0 },
        "client_uss_bytes": { "type": "integer", "minimum": 0 },
        "client_high_water_rss_bytes": { "type": "integer", "minimum": 0 },
        "client_swap_bytes": { "type": "integer", "minimum": 0 },
        "client_minor_faults": { "type": "integer", "minimum": 0 },
        "client_major_faults": { "type": "integer", "minimum": 0 },
        "client_voluntary_switches": { "type": "integer", "minimum": 0 },
        "client_involuntary_switches": { "type": "integer", "minimum": 0 },
        "client_threads": { "type": "integer", "minimum": 0 },
        "client_file_descriptors": { "type": "integer", "minimum": 0 },
        "client_socket_descriptors": { "type": "integer", "minimum": 0 },
        "subject_user_ticks": { "type": "integer", "minimum": 0 },
        "subject_system_ticks": { "type": "integer", "minimum": 0 },
        "subject_run_nanoseconds": { "type": "integer", "minimum": 0 },
        "subject_read_bytes": { "type": "integer", "minimum": 0 },
        "subject_write_bytes": { "type": "integer", "minimum": 0 },
        "subject_rss_bytes": { "type": "integer", "minimum": 0 },
        "subject_pss_bytes": { "type": "integer", "minimum": 0 },
        "subject_uss_bytes": { "type": "integer", "minimum": 0 },
        "subject_high_water_rss_bytes": { "type": "integer", "minimum": 0 },
        "subject_swap_bytes": { "type": "integer", "minimum": 0 },
        "subject_minor_faults": { "type": "integer", "minimum": 0 },
        "subject_major_faults": { "type": "integer", "minimum": 0 },
        "subject_voluntary_switches": { "type": "integer", "minimum": 0 },
        "subject_involuntary_switches": { "type": "integer", "minimum": 0 },
        "subject_threads": { "type": "integer", "minimum": 0 },
        "subject_file_descriptors": { "type": "integer", "minimum": 0 },
        "subject_socket_descriptors": { "type": "integer", "minimum": 0 },
        "subject_bpf_program_descriptors": { "type": "integer", "minimum": 0 },
        "subject_bpf_link_descriptors": { "type": "integer", "minimum": 0 },
        "subject_bpf_map_memlock_bytes": { "type": "integer", "minimum": 0 },
        "subject_bpf_maps": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "type", "key_size", "value_size", "max_entries", "flags", "memlock_bytes"],
            "properties": {
              "id": { "type": "integer", "minimum": 0 }, "type": { "type": "integer", "minimum": 0 },
              "key_size": { "type": "integer", "minimum": 0 }, "value_size": { "type": "integer", "minimum": 0 },
              "max_entries": { "type": "integer", "minimum": 0 }, "flags": { "type": "integer", "minimum": 0 },
              "memlock_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "system_cpu_ticks": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "system_cpu_by_core": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "integer", "minimum": 0 } } },
        "system_softirqs": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "system_context_switches": { "type": "integer", "minimum": 0 },
        "system_processes_created": { "type": "integer", "minimum": 0 },
        "system_page_faults": { "type": "integer", "minimum": 0 },
        "system_major_page_faults": { "type": "integer", "minimum": 0 },
        "system_migrations": { "type": "integer", "minimum": 0 },
        "interfaces": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rx_bytes", "rx_packets", "rx_errors", "rx_dropped", "tx_bytes", "tx_packets", "tx_errors", "tx_dropped"],
            "properties": {
              "rx_bytes": { "type": "integer", "minimum": 0 }, "rx_packets": { "type": "integer", "minimum": 0 },
              "rx_errors": { "type": "integer", "minimum": 0 }, "rx_dropped": { "type": "integer", "minimum": 0 },
              "tx_bytes": { "type": "integer", "minimum": 0 }, "tx_packets": { "type": "integer", "minimum": 0 },
              "tx_errors": { "type": "integer", "minimum": 0 }, "tx_dropped": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "thermal_before_millicelsius": { "type": "object", "additionalProperties": { "type": "integer" } },
        "thermal_after_millicelsius": { "type": "object", "additionalProperties": { "type": "integer" } },
        "cpu_frequency_before_khz": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "cpu_frequency_after_khz": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "conntrack_count_before": { "type": "integer", "minimum": 0 },
        "conntrack_count_after": { "type": "integer", "minimum": 0 }
      }
    },
    "path_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "method", "observed_at"],
      "properties": {
        "valid": { "type": "boolean" },
        "method": { "type": "string" },
        "observed_at": { "type": "string", "format": "date-time" },
        "before": {},
        "after": {},
        "evidence": {},
        "error": { "type": "string" }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid"],
      "properties": {
        "valid": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "restore_verified", "phases"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "restore_verified": { "type": "boolean" },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "started_at", "finished_at", "success"],
            "properties": {
              "name": { "type": "string" },
              "started_at": { "type": "string", "format": "date-time" },
              "finished_at": { "type": "string", "format": "date-time" },
              "success": { "type": "boolean" },
              "error": { "type": "string" }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "size"],
        "properties": {
          "name": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "truncated": { "type": "boolean" }
        }
      }
    },
    "metadata": {}
  }
}
