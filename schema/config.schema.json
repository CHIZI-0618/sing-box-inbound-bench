{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CHIZI-0618/sing-box-inbound-bench/schema/config.schema.json",
  "title": "sing-box inbound benchmark configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "run_id", "subject", "workload", "execution"],
  "properties": {
    "protocol_version": { "const": "inbound-bench/v2" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["raw", "direct", "ebpf-tc", "ebpf-cgroup"] },
        "sing_box_binary": { "type": "string" },
        "listen": { "type": "string" },
        "target": { "type": "string" },
        "outbound_interface": { "type": "string" },
        "cgroup_path": { "type": "string", "pattern": "^/sys/fs/cgroup/.+" },
        "include_uid": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 } },
        "api_listen": { "type": "string" },
        "api_token": { "type": "string" },
        "extra_arguments": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "direct" } }, "required": ["kind"] },
          "then": { "required": ["sing_box_binary", "listen", "target"] }
        },
        {
          "if": { "properties": { "kind": { "enum": ["ebpf-tc", "ebpf-cgroup"] } }, "required": ["kind"] },
          "then": { "required": ["sing_box_binary", "include_uid", "api_listen", "api_token"] }
        },
        {
          "if": { "properties": { "kind": { "const": "ebpf-cgroup" } }, "required": ["kind"] },
          "then": { "required": ["cgroup_path"] }
        }
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "mode", "target", "payload_bytes"],
      "properties": {
        "protocol": { "enum": ["tcp", "udp"] },
        "mode": { "enum": ["echo", "bulk-upload", "bulk-download", "short", "pps"] },
        "target": { "type": "string" },
        "payload_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "requests": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "connections": { "type": "integer", "minimum": 1 },
        "flows": { "type": "integer", "minimum": 1 },
        "offered_pps": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "timeout_ms": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "oneOf": [
            { "required": ["requests"], "not": { "required": ["duration_ms"] }, "properties": { "requests": { "minimum": 1 } } },
            { "required": ["duration_ms"], "not": { "required": ["requests"] }, "properties": { "duration_ms": { "minimum": 1 } } }
          ]
        },
        {
          "if": { "properties": { "protocol": { "const": "tcp" } }, "required": ["protocol"] },
          "then": { "properties": { "mode": { "enum": ["echo", "bulk-upload", "bulk-download", "short"] } } }
        },
        {
          "if": { "properties": { "protocol": { "const": "udp" } }, "required": ["protocol"] },
          "then": { "properties": { "mode": { "enum": ["echo", "pps"] } } }
        },
        {
          "if": { "properties": { "mode": { "const": "pps" } }, "required": ["mode"] },
          "then": { "required": ["offered_pps"], "properties": { "offered_pps": { "type": "integer", "minimum": 1, "maximum": 1000000000 } } }
        },
        {
          "if": { "properties": { "mode": { "not": { "const": "pps" } } }, "required": ["mode"] },
          "then": { "properties": { "offered_pps": { "const": 0 } } }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetitions", "output_directory"],
      "properties": {
        "warmup_repetitions": { "type": "integer", "minimum": 0 },
        "repetitions": { "type": "integer", "minimum": 1 },
        "output_directory": { "type": "string", "minLength": 1 },
        "temporary_directory": { "type": "string" },
        "startup_timeout_ms": { "type": "integer", "minimum": 1 },
        "worker_uid": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subject": {
            "properties": { "kind": { "enum": ["ebpf-tc", "ebpf-cgroup"] } },
            "required": ["kind"]
          }
        },
        "required": ["subject"]
      },
      "then": { "properties": { "execution": { "required": ["worker_uid"] } } }
    }
  ]
}
