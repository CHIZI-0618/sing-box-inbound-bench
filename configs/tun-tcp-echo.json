    "sing_box_binary": "/usr/local/bin/sing-box",
    "tun_address": ["172.31.255.1/30"],
    "mtu": 1500
  },
  "workload": {
    "protocol": "tcp",
    "mode": "echo",
    "target": "192.0.2.2:19090",
